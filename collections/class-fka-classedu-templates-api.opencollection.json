              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a Template"
        },
        {
          "info": {
            "name": "Update a Template",
            "type": "http"
          },
