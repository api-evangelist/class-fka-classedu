                "description": "Template identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a Template"
        },
        {
          "info": {
            "name": "Remove a Template",
            "type": "http"
