                "description": "Template identifier."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve (positive integer)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Records per page (1-1000)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all templates, or a single template by template_id."
        },
        {
          "info": {
            "name": "Create a Template",
            "type": "http"
          },
