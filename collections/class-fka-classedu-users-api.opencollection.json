{
  "opencollection": "1.0.0",
  "info": {
    "name": "Class Developer Classes Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.class.com/api/v1/users",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "User identifier assigned by Class."
              },
              {
                "name": "ext_user_id",
                "value": "",
                "type": "query",
                "description": "External user identifier supplied by the integrator."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve (positive integer)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Records per page (1-1000)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all users, or a single user by id or ext_user_id."
        },
        {
          "info": {
            "name": "Create or Update a User",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{organization}.class.com/api/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create or Update a User"
        },
        {
          "info": {
            "name": "Remove a User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{organization}.class.com/api/v1/users",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "User identifier assigned by Class."
              },
              {
                "name": "ext_user_id",
                "value": "",
                "type": "query",
                "description": "External user identifier supplied by the integrator."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a User"
        }
      ]
    }
  ],
  "bundled": true
}